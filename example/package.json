{
  "name": "AwesomeProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "npm run codegen:lib && react-native codegen-harmony --ets-output-path ./harmony/entry/src/main/ets/generated",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "pack:pkg": "npm --prefix .. run pack",
    "install:pkg": "npm run pack:pkg && npm install @react-native-ohos/react-native-gif-player@file:../react-native-ohos-react-native-gif-player-1.0.0.tgz --legacy-peer-deps",
    "fast-install-project": "npm run pack:pkg && npm install --legacy-peer-deps",
    "fastpkg": "npm run fast-install-project && npm run dev",
    "fast:pkg": "npm run fastpkg",
    "codegen:lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-gif-player --cpp-output-path ../harmony/gif_player/src/main/cpp/generated --ets-output-path ../harmony/gif_player/src/main/ets/generated --cpp-components-spec-paths ../specs"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.72.146",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "@react-native-ohos/react-native-gif-player": "file:../react-native-ohos-react-native-gif-player-1.0.0.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@react-native-community/cli": "11.3.6",
    "@react-native/codegen": "0.74.0"
  },
  "resolutions": {
    "@react-native-community/cli": "11.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
